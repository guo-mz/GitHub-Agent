# ========== 使用说明 ==========
# 1. cp .env.example .env  后填写密钥（勿提交 .env 到 Git）
# 2. Docker 单体：docker compose up -d --build
# 3. Compose 会覆盖 REDIS_URL / DATABASE_URL 为容器内主机名，本文件可保持 localhost 供本机开发
# 详见 docs/DOCKER部署.md

# ========== LLM ==========
# 支持 OpenAI 兼容接口（OpenAI / DeepSeek / 通义兼容模式等）
LLM_API_KEY=sk-your-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- DeepSeek 示例（取消下面注释，并注释掉上面的 OpenAI 四行即可）---
# LLM_API_KEY=sk-你的deepseek密钥
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# DeepSeek 无兼容的 embedding 接口：可留空模型名，RAG 会自动用本地哈希向量降级
# EMBEDDING_MODEL=

# ========== GitHub ==========
# PAT: repo, read:org, workflow(可选)；OAuth App 用于前端登录
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/callback
# Webhook HMAC 密钥。生产必须配置；未配置时默认拒绝验证成功。
GITHUB_WEBHOOK_SECRET=your-webhook-secret
# 仅本地调试可显式跳过签名（不安全，会打审计日志）：
# ALLOW_INSECURE_WEBHOOK=true

# ========== Redis（HITL checkpoint 需要 Redis Stack，含 RediSearch）==========
# 本机开发：redis://localhost:6379/0
# Docker Compose 会在 compose 的 environment 里覆盖为 redis://redis:6379/0，无需改这里
# 普通 redis:alpine 可能无法初始化 AsyncRedisSaver，将降级 MemorySaver（不可跨重启）
REDIS_URL=redis://localhost:6379/0

# ========== PostgreSQL + pgvector ==========
POSTGRES_USER=agent
POSTGRES_PASSWORD=agent_secret
POSTGRES_DB=github_agent
# 本机开发用 localhost；Docker Compose 会覆盖为 @postgres:5432
DATABASE_URL=postgresql+asyncpg://agent:agent_secret@localhost:5432/github_agent

# ========== Langfuse ==========
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxx
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxx
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_NEXTAUTH_SECRET=changeme-langfuse-nextauth-secret
LANGFUSE_SALT=changeme-langfuse-salt

# ========== App ==========
APP_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_REPO=owner/repo
RATE_LIMIT_GITHUB_PER_HOUR=4500
AGENT_RECURSION_LIMIT=25

# ========== 安全（Phase-1/3）==========
# 本地单操作员共享密钥（非多用户 IAM / 非 per-task ACL）。
# 敏感读（审批/任务/仓库内容/Diff）与写操作均须携带：
#   Header: X-Operator-Token: <同值>
# 或 Authorization: Bearer <同值>
# 前端本机开发：在浏览器控制台执行
#   localStorage.setItem('ga_operator_token', '<同值>')
# 禁止使用 VITE_OPERATOR_TOKEN（会打进前端包，不是秘密）。
OPERATOR_API_TOKEN=change-me-operator-token
# 未配置 OPERATOR_API_TOKEN 时默认拒绝敏感操作。仅本地调试可显式打开（不安全）：
# ALLOW_INSECURE_NO_AUTH=true
# MemorySaver / 无 Redis Stack 时默认拒绝新 HITL 任务。仅本地调试：
# ALLOW_EPHEMERAL_HITL=true
#
# 限制：共享 Token + localStorage 不适合公开互联网；XSS 可泄露浏览器可读凭据。
# 完整方案应改为同源会话 + httpOnly/Secure/SameSite Cookie + CSRF 防护。
# 真实发布仍硬关闭（无可信测试执行器）。

# ========== Microservices (optional; start-micro.ps1 / docker-compose.micro.yml) ==========
# GATEWAY_MODE=micro
# AGENT_SVC_URL=http://127.0.0.1:8011
# REPO_SVC_URL=http://127.0.0.1:8012
# REGISTRY_REDIS_URL=redis://localhost:6379/0
# Agent 独立 Redis DB；Repo/注册表用 0
# REDIS_URL=redis://localhost:6379/1
# REPO_RPC_ENABLED=true
# REPO_RPC_URL=http://127.0.0.1:8012
# 微服内部 RPC 必填：>=16 字符随机串；空/过短/dev-internal-rpc 一律拒绝
# 生成示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
# INTERNAL_RPC_TOKEN=
AGENT_LLM_MAX_RETRIES=3
AGENT_TOOL_MAX_RETRIES=2
AGENT_STREAM_MAX_RETRIES=1
AGENT_RETRY_BASE_DELAY=0.6

# ========== Jev (TypeSafe System One) ==========
# 有 Key 走云端决策；无 Key 自动本地启发式兜底
JEV_ENABLED=true
# TYPESAFE_API_KEY=ts_...
JEV_MODEL=jev-latest
JEV_CONFIDENCE_THRESHOLD=0.7
JEV_ESCALATE_THRESHOLD=0.7

# ========== Transformer Cross-Encoder 精排（Hybrid RAG）==========
# 默认开启；未 pip install sentence-transformers 时自动关键词回退
TRANSFORMER_RERANK_ENABLED=true
TRANSFORMER_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# 安装：pip install -r backend/requirements-transformer.txt

# ========== 上下文工程（进 LLM 前裁剪 / 摘要）==========
# Checkpointer 仍保留完整轨迹；仅工作窗口压缩
CONTEXT_MAX_TOKENS=6000
CONTEXT_KEEP_RECENT=12
CONTEXT_TOOL_MAX_CHARS=4000
CONTEXT_LLM_SUMMARY=true

# ========== 上下文工程（进 LLM 前裁剪；checkpointer 仍保留完整轨迹）==========
CONTEXT_MAX_TOKENS=6000
CONTEXT_KEEP_RECENT=12
CONTEXT_TOOL_MAX_CHARS=4000
CONTEXT_LLM_SUMMARY=true
