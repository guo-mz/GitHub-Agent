# 微服务共用镜像：gateway / agent / repo 仅 CMD 不同
FROM python:3.12-slim

WORKDIR /workspace

RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true \
    && sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl git openssh-client \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /workspace/backend/requirements.txt
RUN pip install --no-cache-dir -i https://pypi.tuna.tsinghua.edu.cn/simple \
    --trusted-host pypi.tuna.tsinghua.edu.cn \
    -r /workspace/backend/requirements.txt

COPY backend/app /workspace/backend/app
COPY backend/scripts /workspace/backend/scripts
COPY services /workspace/services

ENV PYTHONPATH=/workspace:/workspace/backend
ENV PYTHONUNBUFFERED=1

EXPOSE 8001 8011 8012

# 默认起 gateway；compose 里覆盖 command
CMD ["uvicorn", "services.gateway.main:app", "--host", "0.0.0.0", "--port", "8001", "--workers", "1"]
